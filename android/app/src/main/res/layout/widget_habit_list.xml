<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent habits widget: the tile grid fills it completely; the refresh button
     sits on top of the grid in the top-left corner. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Rows of tiles are added here by HabitWidgetProvider. -->
    <LinearLayout
        android:id="@+id/widget_habit_rows"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/widget_habit_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/widget_habit_pill_open"
        android:gravity="center"
        android:padding="12dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/widget_habits_empty"
        android:textColor="@color/widget_ink"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Refresh button. The pill drawable is inset, so the touch area (26dp high) is
         larger than the visible pill (18dp). Turns amber and shows a label when outdated. -->
    <LinearLayout
        android:id="@+id/widget_habit_refresh"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_gravity="top|start"
        android:background="@drawable/widget_habit_pill_open"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_habit_refresh_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            android:src="@drawable/ic_widget_habit_refresh"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_habit_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-3dp"
            android:layout_marginEnd="9dp"
            android:maxLines="1"
            android:text="@string/widget_habits_outdated"
            android:textColor="@color/habit_on_outdated"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
