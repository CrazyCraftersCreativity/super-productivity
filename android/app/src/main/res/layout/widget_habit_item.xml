<?xml version="1.0" encoding="utf-8"?>
<!-- One cell of the habit grid. All cells in a row share its width equally; the tile
     bitmap has the proportions of the cell and is scaled (fitCenter) to fill it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habit_item"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1">

    <ImageView
        android:id="@+id/widget_habit_tile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <!-- Live clock of a running stopwatch / countdown (m:ss). Shown only while running. -->
    <Chronometer
        android:id="@+id/widget_habit_chrono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/widget_ink"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
