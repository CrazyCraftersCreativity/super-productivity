<?xml version="1.0" encoding="utf-8"?>
<!-- One cell of the habit grid. All cells in a row share its width equally; the tile
     bitmap has the proportions of the cell and is scaled (fitCenter) to fill it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habit_item"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1">

    <ImageView
        android:id="@+id/widget_habit_tile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <!-- Live clock of a running stopwatch / countdown, in the tile's top-right corner
         (m:ss, h:mm:ss above an hour). Size and padding are set by HabitWidgetProvider so
         it lines up with the number the tile bitmap shows in the same spot. Shown only
         while a timer runs. -->
    <Chronometer
        android:id="@+id/widget_habit_chrono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:includeFontPadding="false"
        android:fontFeatureSettings="tnum"
        android:gravity="end"
        android:textColor="@color/widget_ink"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
