<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habit_item"
    android:layout_width="40dp"
    android:layout_height="40dp">

    <ImageView
        android:id="@+id/widget_habit_ring"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="center"
        android:src="@drawable/widget_habit_circle_open"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_habit_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/widget_habit_letter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/widget_ink"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Running stopwatch marker -->
    <ImageView
        android:id="@+id/widget_habit_state"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:src="@drawable/ic_widget_habit_stop"
        android:tint="@color/widget_habit_running"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- Count ("3", "3/8") or time ("12m") -->
    <TextView
        android:id="@+id/widget_habit_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:background="@drawable/widget_habit_badge_bg"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:textColor="@color/widget_ink"
        android:textSize="9sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:visibility="gone" />
</FrameLayout>
